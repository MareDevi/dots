#!/usr/bin/env bash

set -euo pipefail

focused_monitor() {
    hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name' 2>/dev/null | head -n1
}

with_swayosd() {
    command -v swayosd-client >/dev/null 2>&1 && pgrep -x swayosd-server >/dev/null 2>&1
}

monitor="$(focused_monitor)"
monitor_args=()
[ -n "${monitor}" ] && monitor_args=(--monitor "$monitor")

case "${1:-}" in
    up)
        if with_swayosd; then
            swayosd-client "${monitor_args[@]}" --output-volume +5 --max-volume 100
        else
            wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
        fi
        ;;
    down)
        if with_swayosd; then
            swayosd-client "${monitor_args[@]}" --output-volume -5 --max-volume 100
        else
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        fi
        ;;
    mute)
        if with_swayosd; then
            swayosd-client "${monitor_args[@]}" --output-volume mute-toggle
        else
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        fi
        ;;
    mic-mute)
        if with_swayosd; then
            swayosd-client "${monitor_args[@]}" --input-volume mute-toggle
        else
            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        fi
        ;;
    *)
        printf 'usage: %s {up|down|mute|mic-mute}\n' "$0" >&2
        exit 2
        ;;
esac
