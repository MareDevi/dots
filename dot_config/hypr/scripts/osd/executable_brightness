#!/usr/bin/env bash

set -euo pipefail

device="${BRIGHTNESS_DEVICE:-nvidia_0}"

focused_monitor() {
    hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name' 2>/dev/null | head -n1
}

with_swayosd() {
    command -v swayosd-client >/dev/null 2>&1 && pgrep -x swayosd-server >/dev/null 2>&1
}

monitor="$(focused_monitor)"
monitor_args=()
[ -n "${monitor}" ] && monitor_args=(--monitor "$monitor")

case "${1:-}" in
    up)
        if with_swayosd; then
            swayosd-client "${monitor_args[@]}" --brightness +5 --device "$device"
        else
            brightnessctl -e4 -n2 -d "$device" set 5%+
        fi
        ;;
    down)
        if with_swayosd; then
            swayosd-client "${monitor_args[@]}" --brightness -5 --device "$device"
        else
            brightnessctl -e4 -n2 -d "$device" set 5%-
        fi
        ;;
    *)
        printf 'usage: %s {up|down}\n' "$0" >&2
        exit 2
        ;;
esac
