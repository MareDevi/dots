#!/usr/bin/env bash

set -u

if ! awww query >/dev/null 2>&1; then
    setsid -f awww-daemon >/dev/null 2>&1
fi

for _ in $(seq 1 20); do
    if awww query >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done

if awww query >/dev/null 2>&1; then
    "${HOME}/.config/hypr/scripts/wallpaper/randomize"
fi
