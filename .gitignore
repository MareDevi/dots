# Local editor and OS noise
.DS_Store
*~
*.swp
*.tmp
__pycache__/
*.pyc
.alma-snapshots/
**/.alma-snapshots/
**/.git/

# Never commit raw secret material.
*.pem
*.key
*.crt
*.p12
*.pfx
*.age
*.asc
id_*
known_hosts
authorized_keys

